{
  "name": "dsh-subagent-qodercn",
  "version": "0.1.0",
  "description": "One-shot Qoder CLI CN subagent provider for DeepSeek Harness over the ACP (Agent Client Protocol) stdio transport",
  "author": "xiangzz",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiangzz/dsh-subagent-qodercn.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "qoder",
    "qodercn",
    "acp"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5",
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "dev": "tsdown --config tsdown.config.mjs --watch",
    "build": "tsdown --config tsdown.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-isolation=none --experimental-strip-types tests/*.test.ts",
    "verify": "pnpm run build && pnpm run typecheck && pnpm test",
    "check": "pnpm run verify && pnpm pack --dry-run",
    "prepublishOnly": "pnpm run verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-brand": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-sdk-protocol": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-timeout": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "24.10.1",
    "tsdown": "0.23.7",
    "typescript": "5.9.3"
  }
}
